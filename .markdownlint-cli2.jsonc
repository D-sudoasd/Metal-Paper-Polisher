{
  // This repository is a documentation / skill package written mostly in
  // Chinese, so a few default markdownlint rules are intentionally relaxed.
  "config": {
    "default": true,
    "MD013": false, // line length: prose lines are long by design
    "MD024": false, // duplicate headings: section templates reuse headings
    "MD033": false, // inline HTML: allowed where needed
    "MD041": false, // first line heading: files may open with frontmatter
    "MD026": false, // trailing punctuation in headings (Chinese punctuation)
    "MD040": false  // fenced code language: template blocks omit a language
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules"]
}
